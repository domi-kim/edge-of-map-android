{
  "appId": "kr.orock.edgeofmap",
  "appName": "지구탐험",
  "webDir": "www",
  "backgroundColor": "#0a0a0a",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false
    },
    "LiveUpdate": {
      "readyTimeout": 15000,
      "autoDeleteBundles": true,
      "autoBlockRolledBackBundles": true
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
