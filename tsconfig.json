{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@game/*": ["./game/src/games/worldexplorer/*"],
      "phaser": ["./game/node_modules/phaser"]
    }
  },
  "include": ["src", "./game/src/env.d.ts"]
}
